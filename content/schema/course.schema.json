{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frrodrig/hitz/content/schema/course.schema.json",
  "title": "Hitz course index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "learningLanguage",
    "fromLanguage",
    "title",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]{2}$"
    },
    "learningLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "fromLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "title": {
      "$ref": "#/$defs/localized"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "title": {
            "$ref": "#/$defs/localized"
          },
          "description": {
            "$ref": "#/$defs/localized"
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^u[0-9]{2}-[0-9]$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "es",
        "eu"
      ],
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "eu": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
