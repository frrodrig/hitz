{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frrodrig/hitz/content/schema/unit.schema.json",
  "title": "Hitz course unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "section",
    "bookUnit",
    "title",
    "goals",
    "guidebook",
    "levels"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^u[0-9]{2}-[0-9]$"
    },
    "section": {
      "type": "string",
      "pattern": "^s[0-9]+$"
    },
    "bookUnit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "title": {
      "$ref": "#/$defs/localized"
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/localized"
      }
    },
    "guidebook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "body"
            ],
            "properties": {
              "title": {
                "$ref": "#/$defs/localized"
              },
              "body": {
                "$ref": "#/$defs/localized"
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "eu",
                    "es"
                  ],
                  "properties": {
                    "eu": {
                      "type": "string",
                      "minLength": 1
                    },
                    "es": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "es",
        "eu"
      ],
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "eu": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[0-9]+)?(\\.[a-z0-9-]+)*$"
    },
    "level": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "title",
            "lessons"
          ],
          "properties": {
            "type": {
              "const": "lesson"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "$ref": "#/$defs/localized"
            },
            "lessons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "exercises"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "exercises": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/exercise"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "title",
            "story"
          ],
          "properties": {
            "type": {
              "const": "story"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "$ref": "#/$defs/localized"
            },
            "story": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "lines",
                "questions"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "lines": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "speaker",
                      "eu",
                      "es"
                    ],
                    "properties": {
                      "speaker": {
                        "type": "string",
                        "minLength": 1
                      },
                      "eu": {
                        "type": "string",
                        "minLength": 1
                      },
                      "es": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "afterLine",
                      "prompt",
                      "options",
                      "correct"
                    ],
                    "properties": {
                      "afterLine": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1
                      },
                      "options": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "correct": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "title"
          ],
          "properties": {
            "type": {
              "enum": [
                "review",
                "legendary"
              ]
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "$ref": "#/$defs/localized"
            }
          }
        }
      ]
    },
    "exercise": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "prompt",
            "answers"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "translate_wordbank"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "prompt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lang",
                "text"
              ],
              "properties": {
                "lang": {
                  "enum": [
                    "eu",
                    "es"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "answers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "distractors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "prompt",
            "answers"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "translate_typing"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "prompt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lang",
                "text"
              ],
              "properties": {
                "lang": {
                  "enum": [
                    "eu",
                    "es"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "answers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "prompt",
            "options",
            "correct"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "choose_image"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "correct": {
              "type": "integer",
              "minimum": 0
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "image"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "image": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+\\.webp$"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "pairs"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "match_pairs"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pairs": {
              "type": "array",
              "minItems": 3,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "eu",
                  "es"
                ],
                "properties": {
                  "eu": {
                    "type": "string",
                    "minLength": 1
                  },
                  "es": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "listen_tap"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "distractors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "answers"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "listen_type"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "answers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "sentence",
            "options",
            "correct",
            "translation"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "fill_blank"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sentence": {
              "type": "string",
              "pattern": "___"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "correct": {
              "type": "integer",
              "minimum": 0
            },
            "translation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "options",
            "correct"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "choose_meaning"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "correct": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "messages",
            "options",
            "correct"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "complete_chat"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "messages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "speaker",
                  "text"
                ],
                "properties": {
                  "speaker": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "correct": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "passage",
            "statement",
            "answer"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "read_true_false"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "passage": {
              "type": "string",
              "minLength": 1
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "answer": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "answer",
            "translation"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "order_sentence"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "translation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "text",
            "translation"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "speak"
            },
            "vocabulary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "structures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "translation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
