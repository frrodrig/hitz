    <string name="feature_onboarding_goal_15">Constante</string>
    <string name="feature_onboarding_goal_20">Intenso</string>
    <string name="feature_onboarding_level_title">¿Has estudiado euskera antes?</string>
    <string name="feature_onboarding_level_beginner">Empiezo desde cero</string>
    <string name="feature_onboarding_level_beginner_body">Empieza por la primera lección.</string>
    <string name="feature_onboarding_level_some">Ya sé algo de euskera</string>
    <string name="feature_onboarding_level_some_body">Haz una prueba corta por cada sección y sáltate lo que ya sabes.</string>
