      "story": {
        "id": "u01-1.l3.story",
        "title": "Lehen eguna",
        "lines": [
          {
            "speaker": "Ane",
            "eu": "Egun on!",
            "es": "¡Buenos días!"
          },
          {
            "speaker": "Iker",
            "eu": "Kaixo! Zer moduz?",
            "es": "¡Hola! ¿Qué tal?"
          },
          {
            "speaker": "Ane",
            "eu": "Oso ondo, eskerrik asko. Ni Ane naiz. Eta zu?",
            "es": "Muy bien, gracias. Soy Ane. ¿Y tú?"
          },
          {
            "speaker": "Iker",
            "eu": "Ni Iker naiz.",
            "es": "Yo soy Iker."
          },
          {
            "speaker": "Ane",
            "eu": "Agur, Iker! Bihar arte!",
            "es": "¡Adiós, Iker! ¡Hasta mañana!"
          },
          {
            "speaker": "Iker",
            "eu": "Gero arte!",
            "es": "¡Hasta luego!"
          }
        ],
        "questions": [
          {
            "afterLine": 2,
            "prompt": "¿Cómo está Ane?",
            "options": [
              "Muy bien",
              "Regular",
              "No lo dice"
            ],
