{
  "schemaVersion": 1,
  "id": "u01-1",
  "section": "s1",
  "bookUnit": 1,
  "title": {
    "es": "¡Hola!",
    "eu": "Kaixo!"
  },
  "goals": [
    {
      "es": "Saludar y despedirse según el momento del día.",
      "eu": "Eguneko unearen arabera agurtu."
    },
    {
      "es": "Usar fórmulas de cortesía: dar las gracias, pedir perdón y felicitar.",
      "eu": "Adeitasun-formulak erabili: eskerrak eman, barkamena eskatu eta zoriondu."
    },
    {
      "es": "Decir tu nombre y preguntar el de otra persona.",
      "eu": "Zure izena esan eta besteena galdetu."
    }
  ],
  "guidebook": {
    "sections": [
      {
        "title": {
          "es": "Saludar según la hora",
          "eu": "Orduaren arabera agurtu"
        },
        "body": {
          "es": "«Egun on» se dice por la mañana, «arratsalde on» por la tarde y «gabon» por la noche, también para despedirse. «Kaixo» sirve a cualquier hora.",
          "eu": "Goizean «egun on» esaten da, arratsaldean «arratsalde on» eta gauean «gabon», agur esateko ere bai. «Kaixo» edozein ordutan erabil daiteke."
        },
        "examples": [
          {
            "eu": "Egun on, Mikel!",
            "es": "¡Buenos días, Mikel!"
          },
          {
            "eu": "Gabon!",
            "es": "¡Buenas noches!"
          }
        ]
      },
      {
        "title": {
          "es": "Presentarse: ni … naiz",
          "eu": "Aurkeztu: ni … naiz"
        },
        "body": {
          "es": "Para decir quién eres: «Ni» + nombre + «naiz». Para preguntar a otra persona: «Nor zara?». El verbo va al final de la frase.",
          "eu": "Nor zaren esateko: «Ni» + izena + «naiz». Besteari galdetzeko: «Nor zara?». Aditza esaldiaren amaieran doa."
        },
        "examples": [
          {
            "eu": "Ni Jon naiz.",
            "es": "Soy Jon."
          },
          {
            "eu": "Nor zara?",
            "es": "¿Quién eres?"
          }
        ]
      },
      {
        "title": {
          "es": "Cortesía",
          "eu": "Adeitasuna"
        },
        "body": {
          "es": "A «eskerrik asko» se responde con «ez horregatik». «Barkatu» sirve para pedir perdón y para llamar la atención de alguien.",
          "eu": "«Eskerrik asko» esaten digutenean, «ez horregatik» erantzuten dugu. «Barkatu» barkamena eskatzeko eta norbaiten arreta erakartzeko erabiltzen da."
        },
        "examples": [
          {
            "eu": "Eskerrik asko!",
            "es": "¡Muchas gracias!"
          },
          {
            "eu": "Ez horregatik.",
            "es": "De nada."
          }
        ]
      }
    ]
  },
